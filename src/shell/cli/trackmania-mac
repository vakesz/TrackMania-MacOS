#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=src/shell/lib/common.sh
. "${SCRIPT_DIR}/../lib/common.sh"

usage() {
  printf 'Usage: trackmania-mac <command> [arguments]\n\n'
  printf 'TrackMania Mac. Commands act on the game TRACKMANIA_MAC_TITLE selects (now: %s).\n\n' \
    "${TRACKMANIA_MAC_TITLE_NAME:-$TRACKMANIA_MAC_TITLE}"
  cat <<'EOF'
Commands:
  install      Download and install Wine and the game
  update       Verify or reinstall the game's pinned official release
  directx      Install the June 2010 DirectX runtime the game uses
  play         Start the game (with Competition Patch, for titles that use it)
  play-vanilla Start the unmodified game; forward optional game arguments
  configure    Open the game's graphics settings launcher
  d9vk         Install the bundled D9VK Direct3D 9 DLL into the prefix
  doctor       Check the installation and print useful diagnostics
  diagnostics  Write a redacted diagnostics zip to ~/Library/TrackManiaMacOS/logs
  stop         Stop the Wine processes of the game's prefix
  app          Install the game and settings apps in Applications
  defaults     Change the game's launch defaults in its installed apps:
               --window-size fullscreen|WIDTHxHEIGHT, --audio on|off, --x87 on|off
  setup        Install runtime, prefix and DirectX without the game
  titles       List supported TrackMania titles and their status
  hub          Native-hub backend (snapshot or run)
  import       Run a retail setup or copy a Steam game folder (TRACKMANIA_MAC_TITLE)
  uninstall    Remove one title's prefix, apps, launcher, cached installer and logs
               after confirmation; --include-saves also removes its saves folder
  migrate      Move every title's files from the folders of earlier releases
               into ~/Library/TrackManiaMacOS (title commands do this first)
  clean        Remove cached downloads, runtimes no installed game uses, or logs
               no game is writing: clean downloads|runtimes|logs
  help         Show this help
EOF
}

# shellcheck source=src/shell/lib/apps/wrappers.sh
. "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/lib/apps/wrappers.sh"
# shellcheck source=src/shell/lib/commands/import.sh
. "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/lib/commands/import.sh"
# shellcheck source=src/shell/lib/commands/hub.sh
. "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/lib/commands/hub.sh"
# shellcheck source=src/shell/lib/commands/play.sh
. "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/lib/commands/play.sh"
# shellcheck source=src/shell/lib/commands/maintain.sh
. "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/lib/commands/maintain.sh"

command="${1:-help}"
case "$command" in
  install|directx|setup|update|play|play-vanilla|configure|d9vk|doctor|stop|app|defaults|import|uninstall|clean)
    migrate_legacy_install
    ;;
esac
case "$command" in
  play|play-vanilla|configure|d9vk|import)
    validate_launch_options
    # Ownership first, so no lock file is created in a prefix this user does not own.
    require_owned_managed_layout
    hold_prefix_operation "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/cli/trackmania-mac" "$@"
    ;;
  uninstall)
    validate_launch_options
    # A title with only its apps or saves left has no prefix to own. The lock
    # (and the refusal while Wine is active) applies either way.
    if test -e "$TRACKMANIA_MAC_PREFIX" || test -L "$TRACKMANIA_MAC_PREFIX"; then
      require_owned_managed_layout
    else
      validate_managed_layout || die "Unsafe installation layout."
    fi
    hold_prefix_operation "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/cli/trackmania-mac" "$@"
    ;;
  update|app)
    validate_launch_options
    guard_prefix_operation "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/cli/trackmania-mac" "$@"
    ;;
  defaults)
    # Arguments first, so a mistake is reported before any lock is taken.
    parse_launcher_defaults "${@:2}"
    validate_launch_options
    require_owned_managed_layout
    hold_prefix_operation "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/cli/trackmania-mac" "$@"
    ;;
  hub|titles|diagnostics)
    # Snapshot and listing must work even with an unrelated launch-option env
    # var mistyped; launch options only matter for play paths below.
    trackmania_mac_title_is_known "$TRACKMANIA_MAC_TITLE" || die "Unknown title: $TRACKMANIA_MAC_TITLE"
    ;;
esac
case "$command" in
  install) exec "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/cli/install.sh" "${@:2}" ;;
  directx) exec "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/cli/install.sh" directx ;;
  setup) exec "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/cli/install.sh" setup ;;
  update) update_game ;;
  play) play_game "${@:2}" ;;
  play-vanilla) play_vanilla "${@:2}" ;;
  configure) configure_game ;;
  d9vk) install_d9vk ;;
  doctor) doctor ;;
  diagnostics) hub_command diagnostics ;;
  stop) stop_game ;;
  app) install_app ;;
  defaults) launcher_defaults "${@:2}" ;;
  titles) hub_command titles ;;
  hub) hub_command "${@:2}" ;;
  import) import_source "${2:-}" ;;
  uninstall) uninstall_game "${@:2}" ;;
  clean) trackmania_mac_python -m trackmania_mac.guard.storage clean "${2:-}" ;;
  migrate)
    trackmania_mac_python -m trackmania_mac.guard.relocate run /bin/bash "${TRACKMANIA_MAC_PROJECT_DIR}/src/shell/cli/trackmania-mac" relink-apps
    ;;
  # Internal: trackmania-mac migrate runs it once per title, holding the app lock.
  relink-apps) relink_apps ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
