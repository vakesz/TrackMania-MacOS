Subject: d3d9: Only define the D3DDEVINFO_RESOURCEMANAGER stand-in for old MinGW.

mingw-w64 14 and later define this structure in d3d9types.h, so d9vk's
placeholder redefines it and the build fails. Guard the placeholder on
__MINGW64_VERSION_MAJOR < 14 and use the toolchain's own definition otherwise.

Based on d9vk 905027e.

diff --git a/src/d3d9/d3d9_include.h b/src/d3d9/d3d9_include.h
index 054fb86f..02087d90 100644
--- a/src/d3d9/d3d9_include.h
+++ b/src/d3d9/d3d9_include.h
@@ -49,8 +49,9 @@
 #define D3DSWAPEFFECT_COPY_VSYNC 4
 #endif
 
-// MinGW headers are broken. Who'dve guessed?
-#ifndef _MSC_VER
+// MinGW headers used to be missing this; mingw-w64 >= 14 defines the real
+// struct in d3d9types.h, so only provide the stand-in for older toolchains.
+#if !defined(_MSC_VER) && (!defined(__MINGW64_VERSION_MAJOR) || __MINGW64_VERSION_MAJOR < 14)
 typedef struct _D3DDEVINFO_RESOURCEMANAGER
 {
   char dummy;
