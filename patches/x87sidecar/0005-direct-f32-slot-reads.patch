diff --git a/tests/generate_pc24_slot_cases.py b/tests/generate_pc24_slot_cases.py
new file mode 100644
index 0000000..28c191b
--- /dev/null
+++ b/tests/generate_pc24_slot_cases.py
@@ -0,0 +1,204 @@
+"""Generate PC24 vectors for x87 registers read from their 80-bit slots.
+
+Exact rational arithmetic, no native FP oracle. Each case puts an 80-bit value
+on the stack, ends the translation, and then reads the register in a new
+reply, where it is still in Rosetta's 80-bit layout (see
+test_pc24_slot_reads.c). The values cover every encoding class: normal f32
+values at the exponent edges, signed zeros, f32 subnormals, values that need
+more than 24 significand bits, values outside the f32 exponent range,
+infinities, NaNs, and the denormal, pseudo-denormal, unnormal and
+pseudo-infinity encodings.
+"""
+
+from fractions import Fraction as F
+from pathlib import Path
+import struct
+
+BIAS = 16383
+DEFAULT_NAN = ("nan", 1, 0xC000000000000000)
+
+
+def scale(x, n):
+    return x * (1 << n) if n >= 0 else x / (1 << -n)
+
+
+def exponent(x):
+    e = x.numerator.bit_length() - x.denominator.bit_length()
+    return e - 1 if x < scale(F(1), e) else e
+
+
+def round_even(y):
+    q, r = divmod(y.numerator, y.denominator)
+    return q + int(2 * r > y.denominator or (2 * r == y.denominator and q & 1))
+
+
+def decode(m, se):
+    """An 80-bit encoding as ('num', sign, Fraction), ('inf', sign) or a NaN."""
+    sign, e = se >> 15, se & 0x7FFF
+    integer = m >> 63
+    if e == 0x7FFF:
+        if not integer:
+            return DEFAULT_NAN  # pseudo-infinity, pseudo-NaN
+        if m << 1 & (1 << 64) - 1:
+            return ("nan", sign, m | 1 << 62)  # quieted
+        return ("inf", sign)
+    if e == 0:
+        return ("num", sign, scale(F(m), 1 - BIAS - 63))  # denormal, pseudo-denormal
+    if not integer:
+        return DEFAULT_NAN  # unnormal
+    return ("num", sign, scale(F(m), e - BIAS - 63))
+
+
+def f32(bits):
+    sign = bits >> 31
+    e, f = bits >> 23 & 0xFF, bits & 0x7FFFFF
+    assert e not in (0, 0xFF) or (e == 0 and f == 0), "inputs are normal f32 or zero"
+    if e == 0:
+        return ("num", sign, F(0))
+    return ("num", sign, scale(F(f | 1 << 23), e - 127 - 23))
+
+
+def add_pc24(a, b):
+    """x87 fadd with PC=24, RC=nearest, and the extended exponent range."""
+    if a[0] == "nan":
+        return a
+    if b[0] == "nan":
+        return b
+    if a[0] == "inf" or b[0] == "inf":
+        if a[0] == b[0] == "inf" and a[1] != b[1]:
+            return DEFAULT_NAN
+        return a if a[0] == "inf" else b
+    x = (-a[2] if a[1] else a[2]) + (-b[2] if b[1] else b[2])
+    if not x:
+        both_negative = a[1] and b[1] and not a[2] and not b[2]
+        return ("num", int(bool(both_negative)), F(0))
+    e = exponent(abs(x))
+    q = round_even(scale(abs(x), 23 - e))
+    return ("num", int(x < 0), scale(F(q), e - 23))
+
+
+def store_f32(v):
+    if v[0] == "nan":
+        return v[1] << 31 | 0x7FC00000 | (v[2] >> 40 & 0x7FFFFF)
+    if v[0] == "inf":
+        return v[1] << 31 | 0x7F800000
+    sign, x = v[1], v[2]
+    if not x:
+        return sign << 31
+    if x >= scale(F(1), -126):
+        e = exponent(x)
+        q = round_even(scale(x, 23 - e))
+        if q == 1 << 24:
+            q, e = q >> 1, e + 1
+        if e > 127:
+            return sign << 31 | 0x7F800000
+        return sign << 31 | (e + 127) << 23 | (q - (1 << 23))
+    return sign << 31 | round_even(scale(x, 149))  # 2^23 is FLT_MIN itself
+
+
+def store_f64(v):
+    if v[0] == "nan":
+        return v[1] << 63 | 0x7FF << 52 | (v[2] >> 11 & (1 << 52) - 1)
+    if v[0] == "inf":
+        return v[1] << 63 | 0x7FF << 52
+    sign, x = v[1], v[2]
+    if not x:
+        return sign << 63
+    # PC24 results of these cases are normal binary64 values: exact.
+    assert scale(F(1), -1022) <= x < scale(F(1), 1024)
+    return sign << 63 | struct.unpack("<Q", struct.pack("<d", float(x)))[0] & ~(1 << 63)
+
+
+def store_f80(v):
+    if v[0] == "nan":
+        return v[2], v[1] << 15 | 0x7FFF
+    if v[0] == "inf":
+        return 1 << 63, v[1] << 15 | 0x7FFF
+    sign, x = v[1], v[2]
+    if not x:
+        return 0, sign << 15
+    e = exponent(x)
+    m = scale(x, 63 - e)
+    assert m.denominator == 1 and 0 < e + BIAS < 0x7FFF
+    return m.numerator, sign << 15 | (e + BIAS)
+
+
+def f32_bits(x):
+    return struct.unpack("<I", struct.pack("<f", x))[0]
+
+
+VALUES = [
+    ("1.5", 0xC000000000000000, 0x3FFF),
+    ("-2.25", 0x9000000000000000, 0xC000),
+    ("full 24-bit significand", 0xFFFFFF0000000000, 0x4002),
+    ("FLT_MIN", 1 << 63, BIAS - 126),
+    ("-FLT_MAX", 0xFFFFFF0000000000, 0x8000 | (BIAS + 127)),
+    ("+0", 0, 0),
+    ("-0", 0, 0x8000),
+    ("f32 subnormal 2^-149", 1 << 63, BIAS - 149),
+    ("2^-127", 1 << 63, BIAS - 127),
+    ("2^128", 1 << 63, BIAS + 128),
+    ("25-bit significand", (1 << 63) | (1 << 39), 0x3FFF),
+    ("lowest significand bit", (1 << 63) | 1, 0x3FFF),
+    ("53-bit significand", 0xFFFFFFFFFFFFF800, 0xBFFE),
+    ("+inf", 1 << 63, 0x7FFF),
+    ("-inf", 1 << 63, 0xFFFF),
+    ("quiet NaN", 0xC000000000000000, 0x7FFF),
+    ("signaling NaN", 0xA000000000000000, 0xFFFF),
+    ("denormal", 1 << 40, 0),
+    ("pseudo-denormal", 1 << 63, 0x8000),
+    ("unnormal", 1 << 62, 0x3FFF),
+    ("pseudo-zero", 0, 0x3FFF),
+    ("pseudo-infinity", 0, 0x7FFF),
+]
+PAIRS = [(1.0, 0.25), (-1.5, 1.5), (3.0e38, 3.0e38), (1e-30, -1e-30)]
+TINY = ("denormal", "pseudo-denormal")  # below binary64: the sidecar reads them as 0
+
+rows = []
+for name, m, se in VALUES:
+    x = decode(m, se)
+    for y_float, z_float in PAIRS:
+        if name in TINY and y_float == -1.5:
+            continue  # x + y + z would expose the tiny value itself
+        yb, zb = f32_bits(y_float), f32_bits(z_float)
+        y, z = f32(yb), f32(zb)
+        xy = add_pc24(x, y)
+        r4m, r4se = store_f80(add_pc24(xy, z))
+        rows.append(
+            (
+                name,
+                m,
+                se,
+                yb,
+                zb,
+                store_f32(xy),
+                store_f32(x),
+                store_f64(xy),
+                r4m,
+                r4se,
+                store_f32(add_pc24(x, x)),
+            )
+        )
+
+lines = [
+    "/* Generated by generate_pc24_slot_cases.py using exact rational arithmetic. */",
+    "static const struct pc24_slot_case {",
+    "    const char* name;",
+    "    uint64_t m;",
+    "    uint16_t se;",
+    "    uint32_t y, z;",
+    "    uint32_t x_plus_y_f32, x_f32;",
+    "    uint64_t x_plus_y_f64;",
+    "    uint64_t sum_m;",
+    "    uint16_t sum_se;",
+    "    uint32_t x_plus_x_f32;",
+    "} pc24_slot_cases[] = {",
+]
+for r in rows:
+    lines.append(
+        '    {"%s", UINT64_C(0x%016x), 0x%04x, 0x%08x, 0x%08x, 0x%08x, 0x%08x, '
+        "UINT64_C(0x%016x), UINT64_C(0x%016x), 0x%04x, 0x%08x}," % r
+    )
+lines += ["};", ""]
+Path(__file__).with_name("pc24_slot_cases.h").write_text("\n".join(lines))
+print(len(rows), "vectors")
