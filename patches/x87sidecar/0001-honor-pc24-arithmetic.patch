new file mode 100644
index 0000000..c9c09bb
--- /dev/null
+++ b/rosetta_core/src/X87Precision.cpp
@@ -0,0 +1,273 @@
+#include "rosetta_core/X87Precision.hpp"
+
+#include <cassert>
+#include <cstdint>
+#include <vector>
+
+#include "rosetta_core/AssemblerHelpers.hpp"
+#include "rosetta_core/TranslatorHelpers.hpp"
+
+namespace {
+struct Label {
+    struct Use {
+        uint64_t offset;
+        unsigned width, shift;
+    };
+    std::vector<Use> uses;
+    void branch(AssemblerBuffer& b) {
+        uses.push_back({b.end, 26, 0});
+        b.emit(0x14000000);  // B
+    }
+    void zero(AssemblerBuffer& b, int reg, bool nonzero = false) {
+        uses.push_back({b.end, 19, 5});
+        b.emit(0xb4000000 | (uint32_t(nonzero) << 24) | reg);  // CBZ/CBNZ X
+    }
+    void bit(AssemblerBuffer& b, int reg, unsigned bit, bool nonzero = false) {
+        uses.push_back({b.end, 14, 5});
+        b.emit(0x36000000 | ((bit & 32) << 26) | ((bit & 31) << 19) | (uint32_t(nonzero) << 24) |
+               reg);  // TBZ/TBNZ
+    }
+    void bind(AssemblerBuffer& b) {
+        for (const auto& u : uses) {
+            const uint64_t words = (b.end - u.offset) / 4;
+            assert(words < (uint64_t(1) << (u.width - 1)));
+            b.data[u.offset / 4] |= uint32_t(words << u.shift);
+        }
+        uses.clear();
+    }
+};
+
+void mask(AssemblerBuffer& b, int dst, int src, uint64_t value) {
+    LogicalImmEncoding e;
+    const bool ok = is_bitmask_immediate(true, value, e);
+    assert(ok);
+    emit_and_imm(b, 1, dst, e.N, e.immr, e.imms, src);
+}
+void or_mask(AssemblerBuffer& b, int dst, int src, uint64_t value) {
+    LogicalImmEncoding e;
+    const bool ok = is_bitmask_immediate(true, value, e);
+    assert(ok);
+    b.emit(0xb2000000 | (uint32_t(e.N) << 22) | (uint32_t(e.immr) << 16) |
+           (uint32_t(e.imms) << 10) | (src << 5) | dst);
+}
+void extract(AssemblerBuffer& b, int dst, int src, int lo, int count) {
+    emit_bitfield(b, 1, 2, 1, lo, lo + count - 1, src, dst);
+}
+void add(AssemblerBuffer& b, int dst, int lhs, int rhs) {
+    emit_add_sub_shifted_reg(b, 1, 0, 0, 0, rhs, 0, lhs, dst);
+}
+void bic(AssemblerBuffer& b, int dst, int lhs, int rhs) {
+    emit_logical_shifted_reg(b, 1, 0, 1, 0, rhs, 0, lhs, dst);
+}
+void arithmetic(AssemblerBuffer& b, X87Arithmetic op, int dst, int lhs, int rhs) {
+    if (op == X87Arithmetic::Sqrt)
+        emit_fsqrt_f64(b, dst, lhs);
+    else
+        emit_fp_dp2(b, 1, static_cast<int>(op), dst, lhs, rhs);
