+    end.branch(b);
+    fast_restore.bind(b);
+    b.emit(0xd51b4420 | discard);
+    precise.bind(b);
+    free_fpr(result, single_lhs);
+
+    // For nearest rounding, compute a round-to-odd intermediate: truncate
