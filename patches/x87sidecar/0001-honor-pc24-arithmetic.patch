+    b.emit(0xd53b4420 | discard);  // restore status if the f32 range was exceeded
+    emit_fcvt_d_to_s(b, single_lhs, lhs);
+    if (op == X87Arithmetic::Sqrt)
+        emit_fp_dp1(b, 0, 3, single_lhs, single_lhs);
+    else {
+        const int single_rhs = alloc_free_fpr(result);
