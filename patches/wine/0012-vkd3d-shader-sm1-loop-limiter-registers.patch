+                put_u32(buffer, 1);
+            }
+            else if (r == HLSL_REGSET_NUMERIC)
             {
                 put_u32(buffer, vkd3d_make_u32(D3DXRS_FLOAT4, var->regs[r].id));
                 put_u32(buffer, var->bind_count[r]);
@@ -12096,12 +12157,12 @@ static void ctab_write_uniforms(struct ctab_ctx *ctab)
     {
         struct ctab_type_info *var_type_info = &ctab->type_info[var->data_type->type_id];
 
-        for (r = 0; r <= HLSL_REGSET_LAST; ++r)
+        for (r = 0; r <= CTAB_REGSET_INT; ++r)
         {
             enum hlsl_sampler_dim sampler_dim = HLSL_SAMPLER_DIM_GENERIC;
             size_t var_offset, name_offset;
 
-            if (!var->is_uniform || !var->regs[r].allocated || !var->last_read)
+            if (!ctab_has_entry(var, r))
                 continue;
 
             /* Arrays can be used with multiple different dimensions.
@@ -12127,7 +12188,24 @@ static void ctab_write_uniforms(struct ctab_ctx *ctab)
             ctab_write_type(ctab, var->data_type, var->is_combined_sampler, sampler_dim, ctab_start);
             set_u32(buffer, var_offset + 3 * sizeof(uint32_t), var_type_info->bytecode_offset - ctab_start);
 
-            if (var->default_values)
+            if (var->default_values && r == CTAB_REGSET_INT)
+            {
+                unsigned int comp_count = hlsl_type_component_count(var->data_type);
+                uint32_t value[4] = {0, 0, 1, 0};
+                unsigned int default_value_offset;
+
+                /* SetDefaults() passes INT4 defaults to Set*ShaderConstantI()
+                 * as they are, so these are integers, not floats. Native
+                 * writes a scalar as {n, 0, 1, 0}: a "loop" counter with
+                 * start 0 and step 1. */
+                for (unsigned int k = 0; k < comp_count && k < 4; ++k)
+                    value[k] = var->default_values[k].number.u;
+                default_value_offset = bytecode_reserve_bytes(buffer, sizeof(value));
+                set_u32(buffer, var_offset + 4 * sizeof(uint32_t), default_value_offset - ctab_start);
+                for (unsigned int k = 0; k < 4; ++k)
+                    set_u32(buffer, default_value_offset + k * sizeof(uint32_t), value[k]);
+            }
+            else if (var->default_values)
             {
                 unsigned int reg_size = var->data_type->reg_size[HLSL_REGSET_NUMERIC];
                 unsigned int comp_count = hlsl_type_component_count(var->data_type);
@@ -16045,6 +16123,38 @@ static bool unroll_loops(struct hlsl_ctx *ctx, struct hlsl_ir_node *node, void *
     return true;
 }
 
+/* Remove this loop's own condition checks, including the copies placed before
+ * "continue" jumps, but not those of nested loops. */
+static void remove_loop_conditionals(struct hlsl_block *block)
+{
+    struct hlsl_ir_node *instr, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(instr, next, &block->instrs, struct hlsl_ir_node, entry)
+    {
+        if (instr->type == HLSL_IR_IF)
+        {
+            struct hlsl_ir_if *iff = hlsl_ir_if(instr);
+
+            if (iff->is_loop_conditional)
+            {
+                list_remove(&instr->entry);
+                hlsl_free_instr(instr);
+                continue;
+            }
+            remove_loop_conditionals(&iff->then_block);
+            remove_loop_conditionals(&iff->else_block);
+        }
+        else if (instr->type == HLSL_IR_SWITCH)
+        {
+            struct hlsl_ir_switch *s = hlsl_ir_switch(instr);
+            struct hlsl_ir_switch_case *c;
+
+            LIST_FOR_EACH_ENTRY(c, &s->cases, struct hlsl_ir_switch_case, entry)
+                remove_loop_conditionals(&c->body);
+        }
+    }
+}
+
 static bool identify_loop_limiters(struct hlsl_ctx *ctx, struct hlsl_ir_node *node, void *context)
 {
     struct hlsl_block *program = context;
@@ -16060,6 +16170,14 @@ static bool identify_loop_limiters(struct hlsl_ctx *ctx, struct hlsl_ir_node *no
     if (loop->unroll_type == HLSL_LOOP_FORCE_LOOP)
         loop_unrolling_unroll_loop(ctx, program, loop, 255, true);
 
+    /* "rep i#" runs exactly n iterations, where n is the limiter, and every
+     * check of the loop condition was shown to be "k < n" for iteration k.
+     * The checks are redundant with the counter, so drop them. Limiters "rep"
+     * can't take (other components, non-integer types) keep the checks and
+     * are reported when the loop is emitted. */
+    if (is_supported_loop_limiter(loop))
+        remove_loop_conditionals(&loop->body);
+
     return false;
 }
 
