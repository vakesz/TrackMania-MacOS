+
+// RC is independent of PC. No flag-setting instructions: guest NZCV survives.
+// Keep FPSR untouched, so old flags and the operation's new sticky flags survive.
+// This is the upstream exception contract, not x87 SW exception/trap emulation.
+template<class Emit>
+void rounded(AssemblerBuffer& b, int base, int saved, int rc, Emit emit) {
+    Label nearest, down, up, ready;
+    b.emit(0xd53b4400 | saved);
+    emit_ldr_str_imm(b, 1, 0, 1, 0, base, rc);
+    extract(b, rc, rc, 10, 2);
+    nearest.zero(b, rc);
+    down.bit(b, rc, 1);
+    up.bit(b, rc, 0);
+    emit_movn(b, 1, 2, 1, 0x00c0, rc);
+    ready.branch(b);
+    down.bind(b);
+    emit_movn(b, 1, 2, 1, 0x0080, rc);
+    ready.branch(b);
+    up.bind(b);
+    emit_movn(b, 1, 2, 1, 0x0040, rc);
+    ready.branch(b);
+    nearest.bind(b);
+    emit_movn(b, 1, 2, 0, 0, rc);
+    ready.bind(b);
+    // Default-NaN, FZ and host trap enables must not override guest rounding.
+    // Restore every host FPCR bit after the one operation; FPSR is cumulative.
+    b.emit(0xd51b4400 | rc);
+    emit();
+    b.emit(0xd51b4400 | saved);
+}
+}  // namespace
+
+void emit_x87_store_f32(TranslationResult& result, AssemblerBuffer& b, int base,
+                        int dst, int src) {
+    const int saved = alloc_free_gpr(result);
+    const int rc = alloc_free_gpr(result);
