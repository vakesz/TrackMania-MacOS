+    b.emit(0xd53b4400 | tmp);
+    mask(b, tmp, tmp, 0x01c00000);  // host nearest, no flush-to-zero
+    precise.zero(b, tmp, true);
+    auto check_operand = [&](int input, Label& zero) {
+        b.emit(0x9e660000 | (input << 5) | bits);
+        mask(b, tmp, bits, 0x1fffffff);  // no precision lost converting to f32
+        precise.zero(b, tmp, true);
+        mask(b, tmp, bits, 0x7fffffffffffffff);
+        zero.zero(b, tmp);
+        extract(b, tmp, bits, 52, 11);
+        emit_add_imm(b, 1, 1, 0, 0, 897, tmp, tmp);
+        extract(b, discard, tmp, 8, 56);
+        precise.zero(b, discard, true);  // exponent below -126 or above 129
+        emit_add_imm(b, 1, 0, 0, 0, 2, tmp, tmp);
+        extract(b, discard, tmp, 8, 56);
+        precise.zero(b, discard, true);  // exclude exponents 128 and 129
+        zero.bind(b);
+    };
+    check_operand(lhs, fast_zero_lhs);
+    if (op != X87Arithmetic::Sqrt)
+        check_operand(rhs, fast_zero_rhs);
