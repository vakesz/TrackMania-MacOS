Subject: x87: Skip the PC24 operand check for values loaded from an f32.

Requires 0001. The native f32 fast path of 0001 first checks that each operand
is exactly representable as an f32. An operand that is a LoadF32 node in the
same run is a 32-bit float from memory, so it is exact by construction. The
check is skipped for such operands; subnormal, infinite and NaN values still
reach the precise path through the result check. Because an unchecked operand
may be subnormal, the fast path then also requires FIZ to be clear.

diff --git a/rosetta_core/include/rosetta_core/X87Precision.hpp b/rosetta_core/include/rosetta_core/X87Precision.hpp
index c2beb22..0a8aa45 100644
--- a/rosetta_core/include/rosetta_core/X87Precision.hpp
+++ b/rosetta_core/include/rosetta_core/X87Precision.hpp
@@ -6,8 +6,12 @@ struct AssemblerBuffer;
 // Three transient GPRs; two FPRs for Sqrt, three for binary arithmetic.
 // The borrowed GPR and guest NZCV survive.
 enum class X87Arithmetic { Mul = 0, Div = 1, Add = 2, Sub = 3, Sqrt = 4 };
+// exact_f32: bit 0 (lhs) / bit 1 (rhs) set when the operand is known at
+// translation time to be a value loaded from a 32-bit float, so the PC24 fast
+// path can skip its exactness check for it.
 void emit_x87_arithmetic(TranslationResult& result, AssemblerBuffer& buf, int base, int scratch,
-                         X87Arithmetic op, int dst, int lhs, int rhs = -1);
+                         X87Arithmetic op, int dst, int lhs, int rhs = -1,
+                         unsigned exact_f32 = 0);
 
 // Two transient GPRs, no FPRs. Preserves FPCR/NZCV; accumulates FPSR flags.
 void emit_x87_store_f32(TranslationResult& result, AssemblerBuffer& buf, int base,
diff --git a/rosetta_core/src/X87IRLower.cpp b/rosetta_core/src/X87IRLower.cpp
index e77462f..a111063 100644
--- a/rosetta_core/src/X87IRLower.cpp
+++ b/rosetta_core/src/X87IRLower.cpp
@@ -120,6 +120,19 @@ static bool narrows_native_slot(const Context& ctx, const Node& n) {
     return src.op == Op::ReadSt && ((ctx.native_depths >> src.initial_depth) & 1U) != 0;
 }
 
+// Bit 0 / bit 1: inputs[0] / inputs[1] is a LoadF32, so its value is exactly
+// representable as an f32 and the PC24 fast path need not check it.
+static unsigned loaded_f32_inputs(const Context& ctx, const Node& n) {
+    unsigned mask = 0;
+    for (int k = 0; k < 2; k++) {
+        const int input = n.inputs[k];
+        if (input >= 0 && input < ctx.num_nodes && ctx.nodes[input].op == Op::LoadF32) {
+            mask |= 1U << k;
+        }
+    }
+    return mask;
+}
