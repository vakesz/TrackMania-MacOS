     list_move_tail(&ctx->extern_vars, &sorted);
 }
 
+/* A pseudo register set after the HLSL ones, for the i# register of a loop
+ * limiter. */
+#define CTAB_REGSET_INT (HLSL_REGSET_LAST + 1)
+
+static bool ctab_has_entry(const struct hlsl_ir_var *var, unsigned int r)
+{
+    if (!var->is_uniform)
+        return false;
+    if (r == CTAB_REGSET_INT)
+        return var->limiter_reg.allocated;
+    return var->regs[r].allocated && var->last_read;
+}
+
 static void ctab_write_uniforms(struct ctab_ctx *ctab)
 {
     size_t ctab_start, vars_offset, vars_start, creator_offset, offset;
@@ -12030,9 +12086,9 @@ static void ctab_write_uniforms(struct ctab_ctx *ctab)
 
     LIST_FOR_EACH_ENTRY(var, &ctx->extern_vars, struct hlsl_ir_var, extern_entry)
     {
-        for (r = 0; r <= HLSL_REGSET_LAST; ++r)
+        for (r = 0; r <= CTAB_REGSET_INT; ++r)
         {
-            if (!var->is_uniform || !var->regs[r].allocated || !var->last_read)
+            if (!ctab_has_entry(var, r))
                 continue;
 
             ++uniform_count;
@@ -12069,13 +12125,18 @@ static void ctab_write_uniforms(struct ctab_ctx *ctab)
 
     LIST_FOR_EACH_ENTRY(var, &ctx->extern_vars, struct hlsl_ir_var, extern_entry)
