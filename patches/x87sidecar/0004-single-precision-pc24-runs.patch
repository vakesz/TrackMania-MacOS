+// ── PC24 single-precision runs ──────────────────────────────────────────────
+//
+// A run whose values come from loads and constants that are f32 values, and
+// whose arithmetic is + - * / sqrt, can run in single precision when, at run
+// entry, the guest is at PC24 with RC=nearest and the host FPCR rounds to
+// nearest with FZ, DN and FIZ clear. For f32 operands an f32 operation then
+// gives exactly the x87 PC24 result whenever that result is a normal f32; for
+// + and - any result is exact (tiny sums of f32 values are representable).
+// Values live in the S view of their node's register, which removes the
+// per-operation f64 -> f32 -> f64 conversions of emit_x87_arithmetic.
+//
+// lower() emits that fast body first, then the exact body unchanged, with the
+// same register assignment. At every node boundary the fast pass records the
+// translator state (x87_cache, free masks, node registers) and the exact pass
+// compares it; any difference disables the fast body by patching its entry
+// into a branch to the exact body. Where a fast operation cannot be exact (a
+// result outside the normal f32 range, a value that is not an f32, an f32
+// NaN or infinity), the fast body converts every live value to f64 in place
+// (exactly) and jumps into the exact body at the start of that node; every
+// value and store before that point was bit-identical to the exact body's.
+// X87_PC24_RUNS=0 disables the fast body.
+
+namespace {
+
+// A branch target in the instruction buffer. Only forward branches (uses before
+// bind()) are emitted: Rosetta's signal state recovery asserts on translated code
+// that branches backward ("unsupported CFG structure").
+struct FLabel {
+    int64_t pos = -1;
+    struct Use {
+        uint64_t at;
+        int kind;  // 0: B imm26, 1: CBZ/CBNZ imm19, 2: TBZ/TBNZ imm14
+    };
+    std::vector<Use> uses;
+
+    static void patch(AssemblerBuffer& b, const Use& u, int64_t target) {
+        const uint32_t words = static_cast<uint32_t>((target - static_cast<int64_t>(u.at)) / 4);
+        uint32_t& w = b.data[u.at / 4];
+        if (u.kind == 0) {
+            w = (w & ~0x03ffffffu) | (words & 0x03ffffffu);
+        } else if (u.kind == 1) {
+            w = (w & ~(0x7ffffu << 5)) | ((words & 0x7ffffu) << 5);
+        } else {
+            w = (w & ~(0x3fffu << 5)) | ((words & 0x3fffu) << 5);
+        }
+    }
+    void use(AssemblerBuffer& b, uint32_t word, int kind) {
+        const Use u{b.end, kind};
+        b.emit(word);
+        if (pos >= 0) {
+            patch(b, u, pos);
+        } else {
+            uses.push_back(u);
+        }
+    }
+    void branch(AssemblerBuffer& b) { use(b, 0x14000000u, 0); }
+    void cbz(AssemblerBuffer& b, bool is_64bit, bool nonzero, int reg) {
+        use(b, 0x34000000u | (uint32_t(is_64bit) << 31) | (uint32_t(nonzero) << 24) | uint32_t(reg), 1);
+    }
+    void tbz(AssemblerBuffer& b, int reg, unsigned bit, bool nonzero) {
+        use(b, 0x36000000u | ((bit & 32u) << 26) | ((bit & 31u) << 19) | (uint32_t(nonzero) << 24) | uint32_t(reg),
+            2);
+    }
+    void bind(AssemblerBuffer& b) {
+        pos = static_cast<int64_t>(b.end);
+        for (const auto& u : uses) {
+            patch(b, u, pos);
+        }
+        uses.clear();
+    }
+};
+
+void emit_and_mask(AssemblerBuffer& b, bool is_64bit, int dst, int src, uint64_t value) {
+    LogicalImmEncoding e;
+    const bool ok = is_bitmask_immediate(is_64bit, value, e);
+    (void)ok;
+    emit_and_imm(b, is_64bit ? 1 : 0, dst, e.N, e.immr, e.imms, src);
+}
+
+bool pc24_runs_enabled() {
+    static const bool enabled = [] {
+        const char* v = getenv("X87_PC24_RUNS");
+        return v == nullptr || strcmp(v, "0") != 0;
+    }();
+    return enabled;
+}
+
+bool f64_is_f32(uint64_t bits) {
+    double d;
+    memcpy(&d, &bits, sizeof(d));
+    const float f = static_cast<float>(d);
+    const double back = static_cast<double>(f);
+    uint64_t back_bits;
+    memcpy(&back_bits, &back, sizeof(back_bits));
+    return back_bits == bits && (bits & 0x7ff0000000000000ull) != 0x7ff0000000000000ull;
+}
+
+// Every node the fast body supports; at least two arithmetic nodes to pay for
+// the entry check.
+bool pc24_run_eligible(const Context& ctx) {
+    int arithmetic = 0;
+    for (int i = 0; i < ctx.num_nodes; i++) {
+        const Node& n = ctx.nodes[i];
+        if (n.flags & kDead) {
+            continue;
+        }
+        if (n.flags & (kFmaReduceHead | kFmaReduceMember)) {
+            return false;
+        }
+        switch (n.op) {
+            case Op::ReadSt:
+            case Op::LoadF64:
+            case Op::LoadF32:
+            case Op::LoadI16:
+            case Op::LoadI32:
+            case Op::ConstZero:
+            case Op::ConstOne:
+            case Op::FNeg:
+            case Op::FAbs:
+            case Op::StoreF64:
+            case Op::StoreF32:
+            case Op::BridgeMovRR:
+            case Op::BridgeMovRI:
+            case Op::BridgeLea:
+            case Op::BridgeLoadG:
+            case Op::BridgeStoreG:
+            case Op::BridgeExt:
+            case Op::BridgeAluRR:
+            case Op::BridgeAluRI:
+            case Op::BridgeAluRM:
+            case Op::BridgeAluMR:
+                break;
+            case Op::ConstF64:
+                if (!f64_is_f32(n.imm_bits)) {
+                    return false;
+                }
+                break;
+            case Op::FAdd:
+            case Op::FSub:
+            case Op::FMul:
+            case Op::FDiv:
+            case Op::FSqrt:
+                arithmetic++;
+                break;
+            default:
+                return false;
+        }
+    }
+    return arithmetic >= 2;
+}
