diff --git a/tests/test_pc24_arithmetic.c b/tests/test_pc24_arithmetic.c
new file mode 100644
index 0000000..1e203c1
--- /dev/null
+++ b/tests/test_pc24_arithmetic.c
@@ -0,0 +1,86 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "pc24_cases.h"
+
+__attribute__((noinline)) static void set_control(unsigned short cw) {
+    __asm__ volatile("fldcw %0" ::"m"(cw) : "memory");
+}
+__attribute__((noinline)) static uint64_t calculate(unsigned op, unsigned form, uint64_t ia,
+                                                    uint64_t ib) {
+    double a, b, r;
+    uint64_t result;
+    memcpy(&a, &ia, 8);
+    memcpy(&b, &ib, 8);
+#define BINARY(insn) \
+    __asm__ volatile("fldl %1; " insn " %2; fstpl %0" : "=m"(r) : "m"(a), "m"(b) : "st", "memory")
+    if (form && op < 4) {
+#define POP(insn)                                           \
+    __asm__ volatile("fldl %1; fldl %2; " insn "; fstpl %0" \
+                     : "=m"(r)                              \
+                     : "m"(a), "m"(b)                       \
+                     : "st", "st(1)", "memory")
+        switch (op) {
+            case 0:
+                POP("faddp");
+                break;
+            case 1:
+                POP("fsubrp");
+                break;
+            case 2:
+                POP("fmulp");
+                break;
+            case 3:
+                POP("fdivrp");
+                break;
+        }
+        memcpy(&result, &r, 8);
+        return result;
+    }
+    switch (op) {
+        case 0:
+            BINARY("faddl");
+            break;
+        case 1:
+            BINARY("fsubl");
+            break;
+        case 2:
+            BINARY("fmull");
+            break;
+        case 3:
+            BINARY("fdivl");
+            break;
+        default:
+            __asm__ volatile("fldl %1; fsqrt; fstpl %0" : "=m"(r) : "m"(a) : "st", "memory");
+            break;
+    }
+    memcpy(&result, &r, 8);
+    return result;
+}
+int main(void) {
+    unsigned short saved;
+    __asm__ volatile("fnstcw %0" : "=m"(saved));
+    unsigned failures = 0, count = 0;
+    for (unsigned i = 0; i < sizeof(pc24_cases) / sizeof(pc24_cases[0]); i++)
+        for (unsigned mode = 0; mode < 4; mode++)
+            for (unsigned form = 0; form < 2; form++) {
+                const struct pc24_case* c = &pc24_cases[i];
+                set_control(0x007f | (mode << 10));
+                uint64_t got = calculate(c->op, form, c->a, c->b);
+                set_control(saved);
+                count++;
+                if (got != c->expected[mode]) {
+                    failures++;
+                    if (failures <= 30)
+                        printf(
+                            "FAIL vector=%u op=%u form=%u rc=%u a=%016llx b=%016llx got=%016llx "
+                            "expected=%016llx\n",
+                            i, c->op, form, mode, (unsigned long long)c->a,
+                            (unsigned long long)c->b, (unsigned long long)got,
+                            (unsigned long long)c->expected[mode]);
+                }
+            }
+    printf("%s %u PC24 cases, %u failures\n", failures ? "FAIL" : "PASS", count, failures);
+    return failures != 0;
+}
diff --git a/tests/test_pc24_host_state.c b/tests/test_pc24_host_state.c
new file mode 100644
index 0000000..52c9da6
--- /dev/null
+++ b/tests/test_pc24_host_state.c
@@ -0,0 +1,32 @@
+/* x87 PC24 arithmetic must not change subsequent SSE rounding. */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+int main(void) {
+    unsigned saved_mxcsr;
+    unsigned short saved_cw;
+    __asm__ volatile("stmxcsr %0; fnstcw %1" : "=m"(saved_mxcsr), "=m"(saved_cw));
+    unsigned short cw = 0x007f;
+    const double one = 1., x87_half = 0x1p-24, sse_half = 0x1p-53;
+    unsigned failures = 0;
+    for (unsigned mode = 0; mode < 4; mode++) {
+        unsigned mxcsr = (saved_mxcsr & ~0x6000u) | (mode << 13), after;
+        double a, b;
+        __asm__ volatile("ldmxcsr %0; fldcw %1" ::"m"(mxcsr), "m"(cw) : "memory");
+        __asm__ volatile(
+            "fldl %2; faddl %3; fstpl %0; movsd %2, %%xmm0; addsd %4, %%xmm0; movsd %%xmm0, %1"
+            : "=m"(a), "=m"(b)
+            : "m"(one), "m"(x87_half), "m"(sse_half)
+            : "st", "xmm0", "memory");
+        __asm__ volatile("stmxcsr %0" : "=m"(after));
+        __asm__ volatile("ldmxcsr %0; fldcw %1" ::"m"(saved_mxcsr), "m"(saved_cw) : "memory");
+        uint64_t bits;
+        memcpy(&bits, &b, 8);
+        uint64_t expected = UINT64_C(0x3ff0000000000000) + (mode == 2);
+        int ok = a == 1. && bits == expected && (after & 0x6000u) == (mxcsr & 0x6000u);
+        printf("%s SSE rounding=%u x87=%.17g SSE=%016llx expected=%016llx\n", ok ? "PASS" : "FAIL",
+               mode, a, (unsigned long long)bits, (unsigned long long)expected);
+        failures += !ok;
+    }
+    return failures != 0;
+}
