     };
-    check_operand(lhs, fast_zero_lhs);
-    if (op != X87Arithmetic::Sqrt)
-        check_operand(rhs, fast_zero_rhs);
+    // A value loaded from an f32 is exactly representable; a subnormal, infinite
+    // or NaN one yields a result outside the normal f32 range, which the result
+    // check below sends to the precise path.
+    if (exact_f32 & 1U)
+        fast_zero_lhs.bind(b);
+    else
+        check_operand(lhs, fast_zero_lhs);
+    if (op != X87Arithmetic::Sqrt) {
+        if (exact_f32 & 2U)
+            fast_zero_rhs.bind(b);
+        else
+            check_operand(rhs, fast_zero_rhs);
+    }
     const int single_lhs = alloc_free_fpr(result);
     b.emit(0xd53b4420 | discard);  // restore status if the f32 range was exceeded
     emit_fcvt_d_to_s(b, single_lhs, lhs);
