+++ b/libs/vkd3d/include/vkd3d_shader.h
@@ -253,6 +253,9 @@ enum vkd3d_shader_compile_option_backward_compatibility
      */
     VKD3D_SHADER_COMPILE_OPTION_BACKCOMPAT_ALLOW_HALF_GLOBALS = 0x00000008,
 
+    /** Allow legacy HLSL functions qualified by a target profile. */
+    VKD3D_SHADER_COMPILE_OPTION_BACKCOMPAT_TARGET_FUNCTIONS = 0x00000010,
+
     VKD3D_FORCE_32_BIT_ENUM(VKD3D_SHADER_COMPILE_OPTION_BACKWARD_COMPATIBILITY),
 };
 
