+    down.bind(b);
+    or_mask(b, tmp, tmp, 0x00800000);
+    fpcr_ready.branch(b);
+    up.bind(b);
+    or_mask(b, tmp, tmp, 0x00400000);
+    fpcr_ready.bind(b);
+    b.emit(0xd51b4400 | tmp);  // MSR FPCR
