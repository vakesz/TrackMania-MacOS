-                emit_x87_arithmetic(*result, buf, Xbase, Wd_tmp, X87Arithmetic::Add, Dd, Dn, Dm);
+                emit_x87_arithmetic(*result, buf, Xbase, Wd_tmp, X87Arithmetic::Add, Dd, Dn, Dm,
+                                    loaded_f32_inputs(ctx, n));
                 break;
             }
