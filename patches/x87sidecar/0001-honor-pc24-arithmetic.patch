+    extract(b, discard, bits, 52, 11);
+    emit_add_imm(b, 1, 1, 0, 0, 2047, discard, discard);
+    finite_done.zero(b, discard);
+    no_jam.zero(b, rc, true);
+    emit_logical_shifted_reg(b, 1, 1, 0, 0, tmp, 0, bits, bits);
+    no_jam.bind(b);
+
+    // Round the significand, not the exponent: FCVT to f32 would overflow
