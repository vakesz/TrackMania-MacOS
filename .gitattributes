# Text files are stored with LF; shell scripts and patches break with CRLF.
* text=auto eol=lf

# Patches must reach `git apply` byte for byte, whatever line endings the
# upstream source they change uses.
*.patch -text

# Public TLS test fixtures are compared by hash.
tests/fixtures/tls/*.pem -text
tests/fixtures/tls/*.key -text

# Generated by `uv lock`; collapse it in pull request diffs.
uv.lock linguist-generated=true
