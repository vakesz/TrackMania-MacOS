+static bool is_supported_loop_limiter(const struct hlsl_ir_loop *loop)
+{
+    const struct hlsl_type *type;
+
+    if (!loop->limiter || loop->limiter_component)
+        return false;
+
+    type = loop->limiter->data_type;
+    if (type->class != HLSL_CLASS_SCALAR && type->class != HLSL_CLASS_VECTOR)
+        return false;
+    return type->e.numeric.type == HLSL_TYPE_INT || type->e.numeric.type == HLSL_TYPE_UINT;
+}
+
+/* The application provides a limiter's trip count, so it gets its own i#
+ * register and no DEFI. Allocate these before the shared 255 counter. */
+static bool allocate_constint_registers_for_limiters(struct hlsl_ctx *ctx,
+        struct hlsl_ir_node *instr, void *context)
+{
+    struct register_allocator *allocator = (struct register_allocator *)context;
+    struct hlsl_ir_var *var;
+    struct hlsl_ir_loop *loop;
+
+    if (instr->type != HLSL_IR_LOOP)
+        return false;
+    loop = hlsl_ir_loop(instr);
+
+    if (!is_supported_loop_limiter(loop))
+        return false;
+
+    var = loop->limiter;
+    if (var->limiter_reg.allocated)
+        return false;
+
+    var->limiter_reg = allocate_register(ctx, allocator, 4, 4, 0, false, false, false);
+    TRACE("Allocated loop limiter %s to %s.\n", var->name,
+            debug_register(var->limiter_reg, hlsl_get_vector_type(ctx, HLSL_TYPE_INT, 4)));
+    return true;
+}
+
 static bool allocate_constint_registers_for_loops(struct hlsl_ctx *ctx,
         struct hlsl_ir_node *instr, void *context)
 {
