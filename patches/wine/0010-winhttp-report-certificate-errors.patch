@@ -369,7 +369,7 @@ DWORD netconn_secure_connect( struct netconn *conn, WCHAR *hostname, DWORD secur
 
             new_read_buf = realloc(read_buf, read_buf_size + 1024);
             if(!new_read_buf) {
-                status = E_OUTOFMEMORY;
+                res = ERROR_OUTOFMEMORY;
                 break;
             }
 
@@ -427,16 +427,19 @@ DWORD netconn_secure_connect( struct netconn *conn, WCHAR *hostname, DWORD secur
         }
     }
 
+    if (out_buf.pvBuffer) FreeContextBuffer( out_buf.pvBuffer );
     free(read_buf);
 
     if(status != SEC_E_OK || res != ERROR_SUCCESS) {
-        WARN( "Failed to initialize security context: %#lx\n", status );
+        WARN( "Secure connection failed: SSPI status %#lx, error %lu\n", status, res );
