+    normal_done.branch(b);
+    legacy.bind(b);
+    arithmetic(b, op, dst, lhs, rhs);
+    normal_done.bind(b);
+    end.bind(b);
+    b.emit(0x9e660000 | (saved_tmp << 5) | tmp);
+    free_fpr(result, saved_tmp);
+    free_gpr(result, discard);
+    free_gpr(result, bits);
+    free_gpr(result, rc);
+}
