-                         X87Arithmetic op, int dst, int lhs, int rhs) {
+                         X87Arithmetic op, int dst, int lhs, int rhs, unsigned exact_f32) {
     const int saved_tmp = alloc_free_fpr(result);
     b.emit(0x9e670000 | (tmp << 5) | saved_tmp);  // preserve borrowed GPR
     const int rc = alloc_free_gpr(result);
@@ -142,6 +142,8 @@ void emit_x87_arithmetic(TranslationResult& result, AssemblerBuffer& b, int base
     Label precise, fast_restore, fast_zero_lhs, fast_zero_rhs;
     precise.zero(b, rc, true);
     b.emit(0xd53b4400 | tmp);
+    if (exact_f32 != 0)
+        precise.bit(b, tmp, 0, true);  // FIZ: unchecked f32 operands may be subnormal
     mask(b, tmp, tmp, 0x01c00000);  // host nearest, no flush-to-zero
     precise.zero(b, tmp, true);
     auto check_operand = [&](int input, Label& zero) {
@@ -159,9 +161,19 @@ void emit_x87_arithmetic(TranslationResult& result, AssemblerBuffer& b, int base
         precise.zero(b, discard, true);  // exclude exponents 128 and 129
