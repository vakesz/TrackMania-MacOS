+    b.emit(0xd53b4420 | tmp);
+    emit_logical_shifted_reg(b, 1, 1, 0, 0, tmp, 0, discard, discard);
+    b.emit(0xd51b4420 | discard);  // preserve old and new sticky flags
+    b.emit(0xd51b4400 | bits);     // restore host FPCR, including SSE rounding
+    extract(b, tmp, tmp, 4, 1);
+    b.emit(0x9e660000 | (dst << 5) | bits);  // FMOV X, D
