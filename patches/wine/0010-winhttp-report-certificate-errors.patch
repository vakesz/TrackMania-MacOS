diff --git a/dlls/winhttp/request.c b/dlls/winhttp/request.c
index 1691d05..0633b8f 100644
--- a/dlls/winhttp/request.c
+++ b/dlls/winhttp/request.c
@@ -2012,6 +2012,29 @@ static int get_receive_response_timeout( struct request *request )
     return request->receive_response_timeout;
 }
 
+static DWORD certificate_error_flags( DWORD error )
+{
+    switch (error)
+    {
+    case ERROR_WINHTTP_SECURE_CERT_REV_FAILED:
+        return WINHTTP_CALLBACK_STATUS_FLAG_CERT_REV_FAILED;
+    case ERROR_WINHTTP_SECURE_INVALID_CERT:
+        return WINHTTP_CALLBACK_STATUS_FLAG_INVALID_CERT;
+    case ERROR_WINHTTP_SECURE_CERT_REVOKED:
+        return WINHTTP_CALLBACK_STATUS_FLAG_CERT_REVOKED;
+    case ERROR_WINHTTP_SECURE_INVALID_CA:
+        return WINHTTP_CALLBACK_STATUS_FLAG_INVALID_CA;
+    case ERROR_WINHTTP_SECURE_CERT_CN_INVALID:
+        return WINHTTP_CALLBACK_STATUS_FLAG_CERT_CN_INVALID;
+    case ERROR_WINHTTP_SECURE_CERT_DATE_INVALID:
+        return WINHTTP_CALLBACK_STATUS_FLAG_CERT_DATE_INVALID;
+    case ERROR_WINHTTP_SECURE_CERT_WRONG_USAGE:
+        return WINHTTP_CALLBACK_STATUS_FLAG_CERT_WRONG_USAGE;
+    default:
+        return 0;
+    }
+}
+
 static DWORD open_connection( struct request *request )
 {
     BOOL is_secure = request->hdr.flags & WINHTTP_FLAG_SECURE;
@@ -2147,15 +2170,29 @@ static DWORD open_connection( struct request *request )
             CertFreeCertificateContext( request->server_cert );
             request->server_cert = NULL;
 
-            if ((ret = ensure_cred_handle( request )) ||
-                (ret = netconn_secure_connect( netconn, connect->hostname, request->security_flags,
-                                               &request->cred_handle, request->check_revocation )))
+            if ((ret = ensure_cred_handle( request )))
             {
                 request->netconn = NULL;
                 free( addressW );
                 netconn_release( netconn );
                 return ret;
             }
+            if ((ret = netconn_secure_connect( netconn, connect->hostname, request->security_flags,
+                                               &request->cred_handle, request->check_revocation )))
+            {
+                DWORD flags = certificate_error_flags( ret );
+
+                /* The callback may close the request or retry the connection. */
+                request->netconn = NULL;
+                free( addressW );
+                netconn_release( netconn );
+                if (flags)
+                {
+                    send_callback( &request->hdr, WINHTTP_CALLBACK_STATUS_SECURE_FAILURE, &flags, sizeof(flags) );
+                    return ERROR_WINHTTP_SECURE_FAILURE;
+                }
+                return ret;
+            }
         }
 
         send_callback( &request->hdr, WINHTTP_CALLBACK_STATUS_CONNECTED_TO_SERVER, addressW, lstrlenW(addressW) + 1 );
