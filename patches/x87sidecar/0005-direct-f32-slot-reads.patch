new file mode 100644
index 0000000..9bb0fbf
--- /dev/null
+++ b/tests/test_pc24_slot_reads.c
@@ -0,0 +1,127 @@
+// PC24 runs that read x87 registers still in their 80-bit native slots.
+//
+// Each sequence loads an 80-bit value, then calls an empty function: the call
+// ends the translation, so the reply after it starts with the value in
+// Rosetta's 80-bit layout, and its PC24 run reads the slot. With the
+// single-precision fast body that read is direct for a normal f32 value or a
+// zero; every other encoding must leave for the exact body and give the same
+// result. The expected values come from exact rational arithmetic
+// (generate_pc24_slot_cases.py), not from a native FP oracle.
+//
+//   seq_add:    fld st(0); fadd m32; fstp m32       one arithmetic node
+//   seq_store:  fst m32; fld st(0); fadd m32; fstp m64; fstp st(0)
+//   seq_sum:    fld st(0); fadd m32; fadd m32; fstp m80
+//   seq_double: two copies; fld st(1); fadd st, st(1); fstp m32  (two slot reads)
+//   seq_add also stores the untouched slot with fstp m80, which must keep
+//   every bit.
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "pc24_slot_cases.h"
+
+void seq_add(const void* x80, const float* y, uint32_t* out32, void* out80);
+void seq_store(const void* x80, const float* y, uint32_t* out32, uint64_t* out64);
+void seq_sum(const void* x80, const float* yz, void* out80);
+void seq_double(const void* x80, uint32_t* out32);
+
+__asm__(
+    ".text\n"
+    "_slot_break:\n"
+    "    ret\n"
+    ".globl _seq_add\n"
+    "_seq_add:\n"
+    "    fldt (%rdi)\n"
+    "    call _slot_break\n"
+    "    fld %st(0)\n"
+    "    fadds (%rsi)\n"
+    "    fstps (%rdx)\n"
+    "    call _slot_break\n"
+    "    fstpt (%rcx)\n"
+    "    ret\n"
+    ".globl _seq_store\n"
+    "_seq_store:\n"
+    "    fldt (%rdi)\n"
+    "    call _slot_break\n"
+    "    fsts (%rdx)\n"
+    "    fld %st(0)\n"
+    "    fadds (%rsi)\n"
+    "    fstpl (%rcx)\n"
+    "    fstp %st(0)\n"
+    "    ret\n"
+    ".globl _seq_sum\n"
+    "_seq_sum:\n"
+    "    fldt (%rdi)\n"
+    "    call _slot_break\n"
+    "    fld %st(0)\n"
+    "    fadds (%rsi)\n"
+    "    fadds 4(%rsi)\n"
+    "    fstpt (%rdx)\n"
+    "    fstp %st(0)\n"
+    "    ret\n"
+    ".globl _seq_double\n"
+    "_seq_double:\n"
+    "    fldt (%rdi)\n"
+    "    fldt (%rdi)\n"
+    "    call _slot_break\n"
+    "    fld %st(1)\n"
+    "    fadd %st(1), %st\n"
+    "    fstps (%rsi)\n"
+    "    fstp %st(0)\n"
+    "    fstp %st(0)\n"
+    "    ret\n");
+
+struct f80 {
+    uint64_t m;
+    uint16_t se;
+} __attribute__((packed));
+
+static unsigned failures;
+
+static void check(const char* what, const struct pc24_slot_case* c, uint64_t got,
+                  uint64_t want) {
+    if (got == want)
+        return;
+    failures++;
+    if (failures <= 40)
+        printf("FAIL %s x=%s (%04x:%016llx) y=%08x z=%08x got=%016llx expected=%016llx\n",
+               what, c->name, c->se, (unsigned long long)c->m, c->y, c->z,
+               (unsigned long long)got, (unsigned long long)want);
+}
+
+int main(void) {
+    unsigned short saved, pc24 = 0x007f;
+    __asm__ volatile("fnstcw %0" : "=m"(saved));
+    unsigned count = 0;
+    for (unsigned i = 0; i < sizeof(pc24_slot_cases) / sizeof(pc24_slot_cases[0]); i++) {
+        const struct pc24_slot_case* c = &pc24_slot_cases[i];
+        const struct f80 x = {c->m, c->se};
+        float yz[2];
+        memcpy(&yz[0], &c->y, 4);
+        memcpy(&yz[1], &c->z, 4);
+        uint32_t add32 = 0xdeadbeef, store32 = 0xdeadbeef, double32 = 0xdeadbeef;
+        uint64_t store64 = 0xdeadbeefdeadbeefull;
+        struct f80 kept = {0, 0}, sum = {0, 0};
+
+        __asm__ volatile("fldcw %0" ::"m"(pc24));
+        seq_add(&x, &yz[0], &add32, &kept);
+        seq_store(&x, &yz[0], &store32, &store64);
+        seq_sum(&x, yz, &sum);
+        seq_double(&x, &double32);
+        __asm__ volatile("fldcw %0" ::"m"(saved));
+
+        check("fadd-m32", c, add32, c->x_plus_y_f32);
+        check("kept-m80.m", c, kept.m, c->m);
+        check("kept-m80.se", c, kept.se, c->se);
+        check("fst-m32", c, store32, c->x_f32);
+        check("fadd-m64", c, store64, c->x_plus_y_f64);
+        check("sum-m80.m", c, sum.m, c->sum_m);
+        check("sum-m80.se", c, sum.se, c->sum_se);
+        check("double-m32", c, double32, c->x_plus_x_f32);
+        count += 8;
+    }
+    // run_tests.sh reads the last line when X87_NATIVE_SLOTS=0 must fail it.
+    printf("%s %u PC24 slot-read checks\n%u failures\n", failures ? "FAIL" : "PASS", count,
+           failures);
+    return failures != 0;
+}
