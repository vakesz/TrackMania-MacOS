Subject: winecoreaudio: Disable audio capture on macOS.

TrackMania only plays audio, but Wine's CoreAudio driver opens an input-enabled
AudioUnit while probing or opening the default capture device, which makes macOS
prompt for microphone access the game never uses. Report no capture devices from
the endpoint enumeration, and refuse capture units in get_audiounit(), the one
place input I/O is enabled, so no path can reach the microphone. Playback is
unchanged.

Based on Wine 36b6a2cf679. Exercised by ./tools/smoke-audio.sh,
which enumerate and play render devices only.

diff --git a/dlls/winecoreaudio.drv/coreaudio.c b/dlls/winecoreaudio.drv/coreaudio.c
index 0ec10fe..4eb01c4 100644
--- a/dlls/winecoreaudio.drv/coreaudio.c
+++ b/dlls/winecoreaudio.drv/coreaudio.c
@@ -221,7 +221,13 @@ static NTSTATUS unix_get_endpoint_ids(void *args)
     addr.mScope = kAudioObjectPropertyScopeGlobal;
     addr.mElement = kAudioObjectPropertyElementMain;
     if(params->flow == eRender) addr.mSelector = kAudioHardwarePropertyDefaultOutputDevice;
-    else if(params->flow == eCapture) addr.mSelector = kAudioHardwarePropertyDefaultInputDevice;
+    else if(params->flow == eCapture){
+        /* This runtime only plays audio. Reporting no capture devices keeps
+         * mmdevapi from opening a microphone AudioUnit, so macOS never prompts
+         * for microphone access that TrackMania does not use. */
+        params->result = S_OK;
+        return STATUS_SUCCESS;
+    }
     else{
         params->result = E_INVALIDARG;
         return STATUS_SUCCESS;
@@ -482,6 +488,12 @@ static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID ad
     AudioComponentDescription desc;
     OSStatus sc;
 
+    /* This runtime never records audio. Refusing capture units here is the one
+     * choke point that keeps Wine from opening a microphone AudioUnit through
+     * any path, so macOS never prompts for microphone access. */
+    if(dataflow == eCapture)
+        return NULL;
+
     memset(&desc, 0, sizeof(desc));
     desc.componentType = kAudioUnitType_Output;
     desc.componentSubType = kAudioUnitSubType_HALOutput;
@@ -1187,6 +1199,10 @@ static NTSTATUS unix_is_format_supported(void *args)
     const AudioDeviceID dev_id = dev_id_from_device(params->device);
 
     unit = get_audiounit(params->flow, dev_id);
+    if(!unit){
+        params->result = AUDCLNT_E_UNSUPPORTED_FORMAT;
+        return STATUS_SUCCESS;
+    }
 
     converter = NULL;
     params->result = ca_setup_audiounit(params->flow, unit, params->fmt_in, &dev_desc, &converter);
