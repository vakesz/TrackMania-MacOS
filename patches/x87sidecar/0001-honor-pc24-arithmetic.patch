+    normal_exponent.bind(b);
+    emit_movn(b, 1, 2, 0, 29, tmp);
+    mask_ready.bind(b);
+    emit_movn(b, 1, 2, 0, 1, discard);
+    emit_lslv(b, 1, tmp, discard, discard);
+    emit_add_imm(b, 1, 1, 0, 0, 1, discard, discard);
