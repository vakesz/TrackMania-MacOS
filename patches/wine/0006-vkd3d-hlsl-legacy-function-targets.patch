+unsigned int hlsl_function_profile_score(const struct hlsl_ir_function_decl *decl, const char *profile)
+{
+    if (!decl->profile)
+        return 1;
+    if (!strcmp(decl->profile, profile))
+        return 3;
+    /* The legacy compiler also accepts the stage-wide "vs" and "ps" qualifiers.
+     * Partial versions such as "ps_2" do not match "ps_2_0". */
+    if ((!strcmp(decl->profile, "vs") || !strcmp(decl->profile, "ps"))
+            && !strncmp(decl->profile, profile, 2) && profile[2] == '_')
+        return 2;
+    return 0;
+}
